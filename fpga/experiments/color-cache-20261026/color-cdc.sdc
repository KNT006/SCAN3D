# COLOR uses the identical role_diagnostic_top FIFO/reset implementation and clocks as BG.
# Gray flight <=6ns (<8ns fastest period); only first-stage crossings/asynchronous assertions exempt.
# Local synchronizer stages, RAM and control remain timed. No clock-wide exceptions.
set_max_delay -datapath_only -from [get_regs {u_laser/color/bridge/commands/write_gray[0] u_laser/color/bridge/commands/write_binary[0] u_laser/color/bridge/commands/write_gray[1] u_laser/color/bridge/commands/write_binary[1]}] -to [get_regs {u_laser/color/bridge/commands/write_gray_meta[0] u_laser/color/bridge/commands/write_gray_meta[1]}] 6
