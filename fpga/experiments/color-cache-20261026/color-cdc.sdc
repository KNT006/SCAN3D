set_false_path -to [get_regs {u_laser/color/bridge/commands/reader_up_sync[0] u_laser/color/bridge/commands/writer_up_sync[0]}]
set_false_path -to [get_pins {u_laser/color/bridge/commands/write_release_reg*.*sr u_laser/color/bridge/commands/read_release_reg*.*sr}]
